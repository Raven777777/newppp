    { "dot": "cyan", "title": "主路径", "items": ["WebTransport：TCP 会话 = 1 条 bidi 流，UDP = DATAGRAM，控制帧走专用流", "帧协议 20 字节定长头 + 会话 ID 多路复用，SessionID 上限每连接 64"] },
    { "dot": "emerald", "title": "降级链", "items": ["WebTransport → HTTPS POST，按错误类型切换：传输层故障才回落", "熔断器：连续 3 次传输故障后熔断 60s，到期放行一次探测", "wss 变体专供 Cloudflare 等会缓冲请求体的代理环境"] },
    { "dot": "rose", "title": "安全", "items": ["外层 QUIC-TLS；内层 E2E 为 HKDF(password) 派生密钥的 ChaCha20-Poly1305", "Bearer HMAC 时间窗 + AUTH 首帧双重认证，防重放缓存 5 万容量", "认证失败返回 404/伪装页，不暴露 401"] }
